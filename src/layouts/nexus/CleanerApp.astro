---
const benefits = [
  { title: 'GPS Check-in / Check-out', description: 'Real-time location tracking for accurate arrival and departure times.', icon: '<path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/>' },
  { title: 'Clear Daily Schedules', description: 'Cleaners view their assigned jobs, routes, and postcodes instantly on their phone.', icon: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18m-14 5 2 2 4-4"/>' },
  { title: 'Photo Proof (Before & After)', description: 'Upload photos of completed tasks to guarantee quality and prevent disputes.', icon: '<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3Z"/><circle cx="12" cy="13" r="3"/>' },
  { title: 'Direct In-App Chat', description: 'Say goodbye to messy WhatsApp groups. Keep all work communication in one place.', icon: '<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/><path d="M8 10h8M8 14h5"/>' },
  { title: 'Safety & COSHH Access', description: 'Quick access to product safety guidelines and company documents on the go.', icon: '<path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"/><path d="m9 12 2 2 4-4"/>' },
];
---
<section id="cleaner-app" class="sp cma-cleaner-app" aria-labelledby="cleaner-app-title">
  <div class="container">
    <div class="text-center mb-5 rv">
      <span class="slbl">The Cleaner App</span>
      <h2 id="cleaner-app-title" class="stitle">A Built-In Mobile App for <span class="gt">Your Cleaning Crew</span></h2>
      <p class="ssub mx-auto">Equipped with everything your team needs to stay on schedule, communicate easily, and prove high-quality work in the field.</p>
    </div>
    <div class="row g-4 justify-content-center">
      {benefits.map((benefit, index) => (
        <article class="col-md-6 col-xl-4 rv" style={`transition-delay:${index * 0.05}s`}>
          <div class="gc p-4 h-100 cma-cleaner-card">
            <span class="cma-cleaner-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={benefit.icon} />
            </span>
            <h3 class="fs-5 fw-semibold mb-2">{benefit.title}</h3>
            <p>{benefit.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
