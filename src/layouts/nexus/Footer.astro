---
import template from "./Footer.html?raw";
import { newsletterUrl, supabasePublishableKey } from "@/lib/supabase-public";
const escapeAttr = (s: string) => s.replaceAll("&", "&amp;").replaceAll('"', "&quot;").replaceAll("<", "&lt;");
const html = template.replace("__NEWSLETTER_URL__", escapeAttr(newsletterUrl)).replace("__SUPABASE_PUBLIC_KEY__", escapeAttr(supabasePublishableKey));
---
<Fragment set:html={html} />
