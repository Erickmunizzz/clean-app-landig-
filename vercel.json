{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/admin", "destination": "https://cleanmaapp-erick-bae5.vercel.app/admin" },
    { "source": "/admin/:path*", "destination": "https://cleanmaapp-erick-bae5.vercel.app/admin/:path*" },
    { "source": "/cleaner", "destination": "https://cleanmaapp-erick-bae5.vercel.app/cleaner" },
    { "source": "/cleaner/:path*", "destination": "https://cleanmaapp-erick-bae5.vercel.app/cleaner/:path*" },
    { "source": "/planos", "destination": "https://cleanmaapp-erick-bae5.vercel.app/planos" },
    { "source": "/suspended", "destination": "https://cleanmaapp-erick-bae5.vercel.app/suspended" },
    { "source": "/auth", "destination": "https://cleanmaapp-erick-bae5.vercel.app/auth" },
    { "source": "/subscribe/:path*", "destination": "https://cleanmaapp-erick-bae5.vercel.app/subscribe/:path*" },
    { "source": "/client-payment-result", "destination": "https://cleanmaapp-erick-bae5.vercel.app/client-payment-result" },
    { "source": "/cleanma-logo.jpg", "destination": "https://cleanmaapp-erick-bae5.vercel.app/cleanma-logo.jpg" },
    { "source": "/cleanma-favicon.png", "destination": "https://cleanmaapp-erick-bae5.vercel.app/cleanma-favicon.png" },
    { "source": "/assets/:path*", "destination": "https://cleanmaapp-erick-bae5.vercel.app/assets/:path*" },
    { "source": "/api/:path*", "destination": "https://cleanmaapp-erick-bae5.vercel.app/api/:path*" }
  ]
}
