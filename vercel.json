{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "redirects": [
    { "source": "/login", "destination": "/admin/login", "permanent": false },
    { "source": "/login/admin", "destination": "/admin/login", "permanent": false },
    { "source": "/login/cleaner", "destination": "/cleaner/login", "permanent": false },
    { "source": "/subscribe", "destination": "/planos", "permanent": false }
  ],
  "headers": [
    {
      "source": "/_serverFn/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "rewrites": [
    { "source": "/sw.js", "destination": "https://cleanmaapp.online/sw.js" },
    { "source": "/manifest-owner.webmanifest", "destination": "https://cleanmaapp.online/manifest-owner.webmanifest" },
    { "source": "/manifest-cleaner.webmanifest", "destination": "https://cleanmaapp.online/manifest-cleaner.webmanifest" },
    { "source": "/pwa/:path*", "destination": "https://cleanmaapp.online/pwa/:path*" },
    { "source": "/admin", "destination": "https://cleanmaapp.online/admin" },
    { "source": "/admin/:path*", "destination": "https://cleanmaapp.online/admin/:path*" },
    { "source": "/cleaner", "destination": "https://cleanmaapp.online/cleaner" },
    { "source": "/cleaner/:path*", "destination": "https://cleanmaapp.online/cleaner/:path*" },
    { "source": "/planos", "destination": "https://cleanmaapp.online/planos" },
    { "source": "/suspended", "destination": "https://cleanmaapp.online/suspended" },
    { "source": "/auth", "destination": "https://cleanmaapp.online/auth" },
    { "source": "/assets/:path*", "destination": "https://cleanmaapp.online/assets/:path*" },
    { "source": "/_serverFn/:path*", "destination": "https://cleanmaapp.online/_serverFn/:path*" },
    { "source": "/api/:path*", "destination": "https://cleanmaapp.online/api/:path*" },
    { "source": "/login/:path*", "destination": "https://cleanmaapp.online/login/:path*" },
    { "source": "/cleaner.html", "destination": "https://cleanmaapp.online/cleaner.html" },
    { "source": "/funcionario", "destination": "https://cleanmaapp.online/funcionario" },
    { "source": "/client-portal", "destination": "https://cleanmaapp.online/client-portal" },
    { "source": "/client-payment-result", "destination": "https://cleanmaapp.online/client-payment-result" },
    { "source": "/cleanma-logo.png", "destination": "https://cleanmaapp.online/cleanma-logo.png" }
  ]
}
