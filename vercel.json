{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/admin", "destination": "https://cleanmaapp-f2qq.vercel.app/admin" },
    { "source": "/admin/:path*", "destination": "https://cleanmaapp-f2qq.vercel.app/admin/:path*" },
    { "source": "/cleaner", "destination": "https://cleanmaapp-f2qq.vercel.app/cleaner" },
    { "source": "/cleaner/:path*", "destination": "https://cleanmaapp-f2qq.vercel.app/cleaner/:path*" },
    { "source": "/planos", "destination": "https://cleanmaapp-f2qq.vercel.app/planos" },
    { "source": "/suspended", "destination": "https://cleanmaapp-f2qq.vercel.app/suspended" },
    { "source": "/auth", "destination": "https://cleanmaapp-f2qq.vercel.app/auth" },
    { "source": "/assets/:path*", "destination": "https://cleanmaapp-f2qq.vercel.app/assets/:path*" },
    { "source": "/api/:path*", "destination": "https://cleanmaapp-f2qq.vercel.app/api/:path*" }
  ]
}
