{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/admin", "destination": "https://origin.cleanmaapp.com/admin" },
    { "source": "/admin/:path*", "destination": "https://origin.cleanmaapp.com/admin/:path*" },
    { "source": "/cleaner", "destination": "https://origin.cleanmaapp.com/cleaner" },
    { "source": "/cleaner/:path*", "destination": "https://origin.cleanmaapp.com/cleaner/:path*" },
    { "source": "/planos", "destination": "https://origin.cleanmaapp.com/planos" },
    { "source": "/suspended", "destination": "https://origin.cleanmaapp.com/suspended" },
    { "source": "/auth", "destination": "https://origin.cleanmaapp.com/auth" },
    { "source": "/assets/:path*", "destination": "https://origin.cleanmaapp.com/assets/:path*" },
    { "source": "/api/:path*", "destination": "https://origin.cleanmaapp.com/api/:path*" },
    { "source": "/cleaner.html", "destination": "https://origin.cleanmaapp.com/cleaner.html" },
    { "source": "/funcionario", "destination": "https://origin.cleanmaapp.com/funcionario" },
    { "source": "/client-portal", "destination": "https://origin.cleanmaapp.com/client-portal" },
    { "source": "/client-payment-result", "destination": "https://origin.cleanmaapp.com/client-payment-result" },
    { "source": "/cleanma-logo.png", "destination": "https://origin.cleanmaapp.com/cleanma-logo.png" }
  ]
}
