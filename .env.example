# Public values embedded in the Astro build; safe for browser use.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only Stripe credentials. Never prefix these with PUBLIC_.
STRIPE_SECRET_KEY=
# Official recurring GBP Stripe Price IDs; six distinct prices.
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_GROWTH_MONTH=
STRIPE_PRICE_GROWTH_YEAR=
STRIPE_PRICE_SCALE_MONTH=
STRIPE_PRICE_SCALE_YEAR=
# Configure durable webhook fulfilment before enabling live payments.
